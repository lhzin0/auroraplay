<?xml version="1.0" encoding="utf-8"?>
<!--
  AuroraPlay mark: a crossbar-less "A" drawn as a constant-thickness stroke
  (round caps + round join at the apex), with a smaller stroked chevron in the
  opening. Symmetric about the vertical centreline (x=54).

  Sized deliberately small in the 108 canvas — content roughly x/y 40..68, so
  with the ~10-unit stroke the visible mark spans about x 35..73 — leaving the
  generous padding a launcher circle mask expects, instead of the old version
  that ran nearly edge to edge and read as cramped.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Main limbs -->
    <path
        android:pathData="M40,68 L54,42 L68,68"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="47"
                android:startY="40"
                android:endX="58"
                android:endY="70">
                <item android:offset="0.0" android:color="#FF00ACFC" />
                <item android:offset="0.50" android:color="#FF5161FB" />
                <item android:offset="1.0" android:color="#FF8B44FB" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner chevron -->
    <path
        android:pathData="M48.5,68 L54,54 L59.5,68"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeColor="#FFB79BFF"
        android:strokeAlpha="0.55" />
</vector>
