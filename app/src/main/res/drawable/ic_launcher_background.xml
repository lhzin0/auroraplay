<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background — a dark, matte "3D" tile in the spirit of the
  OneDark 3D icon pack: near-black, lit softly from the top so it reads as a
  gently domed square rather than a flat card. The launcher's own squircle
  mask + drop shadow finish the shape.

    · base    : vertical gradient, #24262F (top) -> #0B0C10 (bottom)
    · dome    : broad radial highlight, top-centre, very low alpha
    · grounding: soft dark vignette pulled in from the bottom corners
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base body -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="-6"
                android:endX="54" android:endY="112">
                <item android:offset="0.0" android:color="#FF24262F" />
                <item android:offset="0.55" android:color="#FF141620" />
                <item android:offset="1.0" android:color="#FF0B0C10" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top dome highlight -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="30"
                android:gradientRadius="74">
                <item android:offset="0.0" android:color="#22FFFFFF" />
                <item android:offset="0.6" android:color="#0BFFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom grounding vignette -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="118"
                android:gradientRadius="96">
                <item android:offset="0.0" android:color="#66000000" />
                <item android:offset="0.7" android:color="#22000000" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
