<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background. Kept as a near-black graphite field with a very
  slight diagonal lift, matching the app's own BackgroundBase (#07070A) so the
  launcher icon reads as part of the product rather than a separate brand mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#FF16161C" />
                <item android:offset="0.55" android:color="#FF0C0C11" />
                <item android:offset="1.0" android:color="#FF07070A" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
