<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+).

  cloud-backup  = Google Drive Auto Backup.
  device-transfer = phone-to-phone copy during setup.

  Both carry only the UserDataBackup snapshot at files/backup/. The catalog DB,
  DataStore and the encrypted credential store are excluded — see backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="backup/" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="aurora_secure_credentials.xml" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="downloads/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="backup/" />
        <exclude domain="sharedpref" path="aurora_secure_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
