<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (legacy Auto Backup).

  Backs up ONLY the small user-data snapshot written by UserDataBackup:
  profiles, playlist metadata (no passwords), favourites, watch history and
  settings. The catalog DB re-syncs from the provider and would blow the
  25 MB quota; the encrypted Xtream credentials are excluded on purpose — the
  key can't travel, so the user re-enters the playlist password per device.
-->
<full-backup-content>
    <include domain="file" path="backup/" />

    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="aurora_secure_credentials.xml" />
    <exclude domain="file" path="datastore/" />
    <exclude domain="file" path="downloads/" />
</full-backup-content>
